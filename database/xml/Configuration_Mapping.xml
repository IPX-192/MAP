<?xml version="1.0"?>
<!DOCTYPE database SYSTEM "litesql.dtd">
<database name="MapSysDatabase" namespace="Database">

  <!--0.数据库版本信息表-->
  <object name ="ProductInfoTable">
	<!--版本号-->
	<field name = "strSoftVersion"	type = "string"   default = "1.0.0.1" />
  </object>
  
    <!--1.数据库用户信息表-->
  <object name = "UserInfoTable">
    <!--工号-->
	<field name = "strUserID"   	type = "string"    default = "" />
	<!--名字-->
	<field name = "strUserName"     type = "string"    default = "" />
	<!--工作队-->
	<field name = "strDepartment"   type = "string"    default = "" />
	<!--角色-->
	<field name = "strRole"         type = "string"    default = "0" />
	<!--标签ID-->
	<field name = "itagID"        	type = "integer"   default = "0" />
  </object>
  
  <!--2.标签信息表-->
  <object name = "TagInfoTable">
    <!--标签ID-->
	<field name = "iTagID"     		type = "integer"   default = "" />
	<!--所属地图-->
	<field name = "iMapID"        	type = "integer"   default = "" />
	<!--剩余电量-->
	<field name = "iBattery"        type = "integer"   default = "" />
	<!--标签位置x-->
	<field name = "iPosX"       	type = "integer"   default = "" />
	<!--标签位置y-->
	<field name = "iPosY"       	type = "integer"   default = "" />
	<!--标签位置z-->
	<field name = "iPosZ"       	type = "integer"   default = "" />
	<!--静止时间-->
	<field name = "iStaticTime"     type = "integer"   default = "" />
  </object>
  
  <!--3.系统原点表-->
  <object name = "MapOriginConfig">
	<!--原点位置x-->
	<field name = "iPosX"     		type = "integer"    default = "" />
    <!--原点位置y-->
	<field name = "iPosY"         	type = "integer"    default = "" />
	<!--原点位置z-->
	<field name = "iPosZ"     		type = "integer"    default = "" />
  </object>
  
 </database>