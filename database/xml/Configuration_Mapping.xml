<?xml version="1.0"?>
<!DOCTYPE database SYSTEM "litesql.dtd">
<database name="MapSysDatabase" namespace="Database">

  <!--0.数据库版本信息表-->
  <object name ="ProductInfoTable">
	<!--版本号-->
	<field name = "strSoftVersion"	type = "string"   default = "1.0.0.1" />
  </object>
  
    <!--1.数据库用户信息表-->
  <object name = "UserInfoTable">
    <!--工号-->
	<field name = "strUserID"   	type = "string"    default = "" />
	<!--名字-->
	<field name = "strUserName"     type = "string"    default = "" />
	<!--工作队-->
	<field name = "strDepartment"   type = "string"    default = "" />
	<!--角色-->
	<field name = "strRole"         type = "string"    default = "" />
	<!--标签ID-->
	<field name = "itagID"        	type = "integer"   default = "0" />
  </object>
  
  <!--2.标签信息表-->
  <object name = "TagInfoTable">
    <!--标签ID-->
	<field name = "iTagID"     		type = "integer"   default = "" />
	<!--所属地图-->
	<field name = "iMapID"        	type = "integer"   default = "" />
	<!--剩余电量-->
	<field name = "iBattery"        type = "integer"   default = "" />
	<!--标签位置x-->
	<field name = "iPosX"       	type = "integer"   default = "" />
	<!--标签位置y-->
	<field name = "iPosY"       	type = "integer"   default = "" />
	<!--标签位置z-->
	<field name = "iPosZ"       	type = "integer"   default = "" />
	<!--静止时间-->
	<field name = "iStaticTime"     type = "integer"   default = "" />
  </object>
  
  <!--3.系统原点表-->
  <object name = "MapOriginConfig">
	<!--原点位置x-->
	<field name = "iPosX"     		type = "integer"    default = "" />
    <!--原点位置y-->
	<field name = "iPosY"         	type = "integer"    default = "" />
	<!--原点位置z-->
	<field name = "iPosZ"     		type = "integer"    default = "" />
  </object>
  
    <!--4.标签历史信息表-->
  <object name = "TagDataTable">
    <!--标签ID-->
	<field name = "iTagID"     		type = "integer"   default = "" />
    <!--数据ID-->
	<field name = "iDataID"     	type = "integer"   default = "" />
	<!--保存时间-->
	<field name = "saveTime"     	type = "string"    default = "" />
	<!--所属地图-->
	<field name = "iMapID"        	type = "integer"   default = "" />
	<!--剩余电量-->
	<field name = "iBattery"        type = "integer"   default = "" />
	<!--标签位置x-->
	<field name = "iPosX"       	type = "integer"   default = "" />
	<!--标签位置y-->
	<field name = "iPosY"       	type = "integer"   default = "" />
	<!--标签位置z-->
	<field name = "iPosZ"       	type = "integer"   default = "" />
	<!--静止时间-->
	<field name = "iStaticTime"     type = "integer"   default = "" />
	<!--工号-->
	<field name = "strUserID"   	type = "string"    default = "" />
	<!--名字-->
	<field name = "strUserName"     type = "string"    default = "" />
	<!--工作队-->
	<field name = "strDepartment"   type = "string"    default = "" />
	<!--角色-->
	<field name = "strRole"         type = "string"    default = "" />
  </object>
  
    <!--5.设备信息表-->
  <object name = "DevInfoTable">
    <!--设备ID-->
	<field name = "iDevID"     		type = "integer"   default = "" />
	<!--设备号-->
	<field name = "devName"     	type = "string"    default = "" />
    <!--设备位置-->
	<field name = "devPos"         	type = "integer"   default = "" />
	<!--设备宽度-->
	<field name = "devWidth"        type = "integer"   default = "" />
  </object>
  
    <!--6.设备配置表-->
  <object name = "DevConfigTable">
	<!--设备是否正序排序-->
	<field name = "bRightOrder"     type = "boolean"   default = "" />
	<!--最大设备号码-->
	<field name = "maxDev" 	    	type = "integer"   default = "" />
  </object>
  
 </database>